# 服务端口（Railway 会自动注入 PORT，本地开发默认用 3000）
PORT=3000

# JWT 密钥：本地开发可以随便写，正式部署到 Railway 时请换成一串随机的长字符串
# 生成方法(本地终端执行): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_random_secret_string

# 允许跨域访问的前端地址（多个用逗号分隔）。本项目前后端同源部署，通常留空即可
CORS_ORIGIN=

# ---------- 手机验证码 ----------
# true = 开发模式，验证码只打印在后端终端日志里，不会真的发短信(默认，方便本地测试)
# 接入真实短信服务商后，把这个改成 false，并在 backend/lib/otpProvider.js 里接入你选的短信API
OTP_DEV_MODE=true

# 真实短信服务商(smsc.kz)：把上面 OTP_DEV_MODE 改成 false 后，下面这两项才会生效
# 就是你在 smsc.kz 注册时设置的登录名和密码，不是另外的Key
SMSC_LOGIN=
SMSC_PASSWORD=

# ---------- 管理员注册邀请码 ----------
# 管理员登录页注册新管理员账号时需要填写这个邀请码，自己设一个不容易被猜到的字符串
ADMIN_INVITE_CODE=change_this_admin_invite_code

# ---------- Google 登录 ----------
# 去 https://console.cloud.google.com/apis/credentials 创建一个 OAuth 客户端ID(类型选"Web应用")
# 把生成的 Client ID 填在这里，同时也要填到 frontend/config.js 里的 GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=jjfhwfho

# ---------- Kaspi 收款信息 ----------
# 展示给用户看的收款账号信息，付费发布时会显示在页面上
KASPI_PHONE=+7 700 000 0000
KASPI_NAME=您的姓名或店铺名
